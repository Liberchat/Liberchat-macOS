{
  "name": "liberchat",
  "version": "2.0.0",
  "description": "Liberchat Desktop App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build-mac": "electron-builder --mac",
    "package-mac": "electron-packager . liberchat --platform=darwin --arch=x64 --icon=assets/icons/liberchat.icns --overwrite",
    "build-dmg": "./build-macos.sh"
  },
  "build": {
    "appId": "com.liberchat.desktop",
    "productName": "Liberchat",
    "icon": "assets/icons/liberchat",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/liberchat.icns",
      "category": "public.app-category.social-networking",
      "artifactName": "${productName}-${version}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "snap",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Network",
      "icon": "assets/icons/256x256/liberchat.png",
      "artifactName": "${productName}-${version}-${os}.${ext}",
      "maintainer": "Liberchat Team <contact@liberchat.org>"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "assets/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asar": true
  },
  "author": {
    "name": "Liberchat Team",
    "email": "contact@liberchat.org"
  },
  "homepage": "https://github.com/Liberchat/Liberchat",

  "devDependencies": {
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12",
    "electron-packager": "^17.1.2"
  }
}
