{
  "name": "liberchat",
  "version": "2.0.0",
  "description": "Liberchat Desktop App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --mac",
    "package-mac": "electron-packager . liberchat --platform=darwin --arch=x64 --icon=assets/icons/liberchat.icns --overwrite",
    "build-dmg": "./build-macos.sh",
    "clean-build": "./clean-build.sh"
  },
  "build": {
    "appId": "com.liberchat.desktop",
    "productName": "Liberchat",
    "icon": "assets/icons/liberchat",
    "directories": {
      "output": "dist"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/liberchat.icns",
      "category": "public.app-category.social-networking",
      "artifactName": "${productName}-${version}.${ext}"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "assets/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asar": true
  },
  "author": {
    "name": "Liberchat Team",
    "email": "contact@liberchat.org"
  },
  "homepage": "https://github.com/Liberchat/Liberchat",
  "devDependencies": {
    "electron": "^41.1.1",
    "electron-builder": "^26.0.12",
    "electron-packager": "^17.1.2"
  }
}
